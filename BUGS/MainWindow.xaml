<Window x:Class="BUGS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BUGS"
        mc:Ignorable="d"
        Title="Bradshaw Upload and Generate System (BUGS)" Height="450" Width="945">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
            <Button Content="Refresh"  
                Width="120" 
                Padding="5"
                Margin="5"
                Click="Refresh_Click"/>
        
            <Button Content="Add New Contract" 
                Width="120" 
                Padding="5"
                Margin="5"
                Click="AddNewContract_Click"/>
        </StackPanel>
        
        
        <DataGrid x:Name="ContractGrid" Grid.Row="1" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Purchaser" Binding="{Binding Purchaser}" IsReadOnly="True" Width="200"/>
                <DataGridTextColumn Header="Description" Binding="{Binding PropDescription}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Bond" Binding="{Binding BondType}" Width="200"/>
                <DataGridTextColumn Header="City" Binding="{Binding PropCity}" Width="100"/>
                <DataGridTextColumn Header="Effective Date" Binding="{Binding EffectiveDate}" Width="100"/>
                <DataGridTextColumn Header="Through Date" Binding="{Binding ThroughDate}" Width="100"/>
                <DataGridTemplateColumn Header="Action">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Export" 
                                Click="Export_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
