<Window x:Class="BUGS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BUGS"
        mc:Ignorable="d"
        Title="Bradshaw Upload and Generate System (BUGS)" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="ContractDataGrid" AutoGenerateColumns="False" Margin="10" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Street Address" Binding="{Binding StreetAddress}" Width="150"/>
                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="100"/>
                <DataGridTextColumn Header="Property Description" Binding="{Binding PropertyDesc}" Width="100"/>
                <DataGridTextColumn Header="Effective Date" Binding="{Binding EffectiveDate}" Width="150"/>
                <DataGridTextColumn Header="Through Date" Binding="{Binding ThroughDate}" Width="100"/>
                <DataGridTextColumn Header="Renewal Fee" Binding="{Binding RenewalFee}" Width="100"/>
                <DataGridTemplateColumn Header="Export" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Word"
                                    Padding="5,2"
                                    Click="ExportWord_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
