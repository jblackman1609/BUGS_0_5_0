<Window x:Class="BUGS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BUGS"
        mc:Ignorable="d"
        Title="Bradshaw Upload and Generate System (BUGS)" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
            <Button Content="Refresh"  
                Width="120" 
                Padding="5"
                Margin="5"
                Click="Refresh_Click"/>
        
            <Button Content="Add New Contract" 
                Width="120" 
                Padding="5"
                Margin="5"
                Click="AddNewContract_Click"/>
        </StackPanel>

        <DataGrid x:Name="ContractDataGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="10" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Street Address" Binding="{Binding StreetAddress}" Width="150"/>
                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="100"/>
                <DataGridTextColumn Header="Property Description" Binding="{Binding PropertyDesc}" Width="100"/>
                <DataGridTextColumn Header="Effective Date" Binding="{Binding EffectiveDate}" Width="100"/>
                <DataGridTextColumn Header="Through Date" Binding="{Binding ThroughDate}" Width="100"/>
                <DataGridTextColumn Header="Renewal Fee" Binding="{Binding RenewalFee}" Width="100"/>
                <DataGridTemplateColumn Header="Export" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Word"
                                    Padding="5,2"
                                    Click="ExportWord_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
